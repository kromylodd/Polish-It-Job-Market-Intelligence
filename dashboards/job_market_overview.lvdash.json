                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_listings",
                  "displayName": "Total active listings",
                  "rowNumber": 1
