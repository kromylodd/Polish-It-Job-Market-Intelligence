{
  "datasets": [
    {
      "name": "ds_total_listings",
      "displayName": "Total active listings",
      "queryLines": [
        "SELECT count(*) AS total_listings\n",
        "FROM job_market.gold.mart_market_snapshot"
      ]
    },
    {
      "name": "ds_salary_by_tech",
      "displayName": "Median monthly salary by technology (permanent, PLN)",
      "queryLines": [
        "SELECT technology_name,\n",
        "       round(sum(median_salary * listing_count) / sum(listing_count)) AS median_monthly_pln,\n",
        "       sum(listing_count) AS listings\n",
        "FROM job_market.gold.mart_salary_by_technology\n",
        "WHERE lower(employment_type) IN ('permanent','any') AND upper(currency) = 'PLN'\n",
        "GROUP BY technology_name\n",
        "HAVING sum(listing_count) >= 5\n",
        "ORDER BY median_monthly_pln DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ds_demand_wow",
      "displayName": "Hottest technologies (week-over-week)",
      "queryLines": [
        "SELECT technology_name, listing_count, wow_change\n",
        "FROM job_market.gold.mart_demand_by_technology\n",
        "WHERE week_start = (SELECT max(week_start) FROM job_market.gold.mart_demand_by_technology)\n",
        "ORDER BY wow_change DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ds_market_trend",
      "displayName": "Rolling listings & salary trend",
      "queryLines": [
        "SELECT full_date, rolling_7d_listings, rolling_7d_avg_salary\n",
        "FROM job_market.gold.mart_market_trends\n",
        "WHERE full_date > (SELECT min(full_date) FROM job_market.gold.mart_market_trends)\n",
        "ORDER BY full_date"
      ]
    },
    {
      "name": "ds_city_summary",
      "displayName": "Listings by city",
      "queryLines": [
        "SELECT city_name, listing_count, avg_salary_mid\n",
        "FROM job_market.gold.mart_city_summary\n",
        "ORDER BY listing_count DESC\n",
        "LIMIT 12"
      ]
    },
    {
      "name": "ds_top_companies",
      "displayName": "Top hiring companies",
      "queryLines": [
        "SELECT company_name, count(*) AS listing_count\n",
        "FROM job_market.gold.mart_market_snapshot\n",
        "WHERE company_name IS NOT NULL\n",
        "GROUP BY company_name\n",
        "ORDER BY listing_count DESC\n",
        "LIMIT 15"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Market Overview",
      "layout": [
