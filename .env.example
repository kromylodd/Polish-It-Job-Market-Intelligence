# Example environment file — copy to .env and fill in real values.
#   cp .env.example .env    &&    chmod 600 .env
# .env is gitignored; never commit real secrets.
# Load locally with:  set -a && source .env && set +a

# --- Telegram bot (required) ---
# Bot token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-here
# Your numeric chat id from @userinfobot — receives admin commands, feedback,
# and is the default recipient when no user config exists yet.
TELEGRAM_CHAT_ID=000000000

# --- Analytics anonymization (required for real anonymization) ---
# Random secret used to HMAC-hash chat ids before storage. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ANALYTICS_SALT=change-me-to-a-random-64-char-hex-secret

# --- Paths (optional; systemd sets PIPELINE_DB_PATH in deploy) ---
# Local DuckDB the pipeline writes and the bot reads (read-only).
# PIPELINE_DB_PATH=/home/youruser/polish-it-job-market-intelligence/pipeline.duckdb
# Idempotency log for the daily broadcast (defaults to telegram_bot/alerts.db).
# ALERTS_DB_PATH=

# --- Optional tunables (sensible defaults in code) ---
# Daily digest time (Europe/Warsaw).
# BROADCAST_HOUR=8
# BROADCAST_MINUTE=0
# Free-tier listings per run.
# FREE_MAX_LISTINGS=20
# Subscription lifecycle.
# SUBSCRIPTION_GRACE_DAYS=3
# SUBSCRIPTION_REMIND_DAYS=3
# Scraper politeness delay (seconds between page requests).
# REQUEST_DELAY_SECONDS=0.5
