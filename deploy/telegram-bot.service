# systemd unit for the Telegram bot (long-polling, always-on).
#
# Install (as root):
#   sudo cp deploy/telegram-bot.service /etc/systemd/system/
#   # edit the paths/user below to match your host, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now telegram-bot
#   journalctl -u telegram-bot -f      # follow logs
#
# Secrets come from an EnvironmentFile (your .env). Keep it root-readable only:
#   sudo chown botuser:botuser /opt/polish-it-job-market-intelligence/.env
#   sudo chmod 600 /opt/polish-it-job-market-intelligence/.env

[Unit]
Description=Polish IT Job Market — Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/polish-it-job-market-intelligence
EnvironmentFile=/opt/polish-it-job-market-intelligence/.env
ExecStart=/opt/polish-it-job-market-intelligence/.venv/bin/python -m telegram_bot.bot
Restart=always
RestartSec=5
# Runtime files (SQLite stores with billing + user data) owner-only.
UMask=0077
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/polish-it-job-market-intelligence/telegram_bot

[Install]
WantedBy=multi-user.target
